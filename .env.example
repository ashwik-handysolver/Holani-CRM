# Sarvam AI API key (https://dashboard.sarvam.ai)
SARVAM_API_KEY="your-sarvam-key"

# Optional: raise if your Sarvam plan allows longer replies (Starter = 4096)
# SARVAM_MAX_TOKENS=4096

# Optional: how long to wait for Sarvam before giving up (seconds)
# SARVAM_TIMEOUT_SECONDS=300

# Optional: your Sarvam token budget. The token meter then shows tokens left.
# SARVAM_TOKEN_LIMIT=1000000

# Optional: Google Drive folder import (see the Google Drive tab for setup steps)
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# DRIVE_POLL_SECONDS=60
